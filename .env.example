# Keep real values in .env.local (local) and Vercel's encrypted Environment Variables (production).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
# Random private signing key; keep it consistent across hosted website instances.
ADMIN_SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
# Legacy single-owner variable; comma-separated IDs are also accepted.
TELEGRAM_OWNER_CHAT_ID=
# Preferred for multiple owners, for example: 123456789,987654321
TELEGRAM_OWNER_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_SECRET=
TELEGRAM_WEBHOOK_URL=https://mdu-properties-webpage.vercel.app
# Optional local CPU model for floor plan image recognition (research use).
# Start services/floorplan/app.py, then set this URL on the Node server.
FLOORPLAN_RECOGNITION_URL=http://127.0.0.1:8765
# Set the same token on both services if exposing recognition over HTTPS.
FLOORPLAN_SERVICE_TOKEN=
# Original FLRplanner recognition. MitUNet is an optional comparison only.
FLOORPLAN_ENGINE=cubicasa5k
FLOORPLAN_DEVICE=cpu
# Containers may set this to 0.0.0.0 behind authenticated HTTPS ingress.
FLOORPLAN_BIND_HOST=127.0.0.1
# Optional local semantic reviewer. Extraction remains independent; request opt-in.
# off, ollama (local Qwen3-VL), or laya-vision (isolated offline Python worker).
FLOORPLAN_VISION_PROVIDER=off
FLOORPLAN_VISION_URL=http://127.0.0.1:11434
FLOORPLAN_VISION_MODEL=qwen3-vl:4b
# Optional RapidOCR evidence; install its pinned dependencies explicitly.
FLOORPLAN_VISION_OCR=0
# Laya Vision fork Python executable and downloaded local checkpoint directory.
# Keep its noncommercial weights out of commercial deployments without permission.
FLOORPLAN_LAYA_PYTHON=
FLOORPLAN_LAYA_MODEL_PATH=
FLOORPLAN_LAYA_DEVICE=cpu
