{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "website": {
      "root": ".",
      "framework": "node",
      "entrypoint": "server.js",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "functions": {
        "server.js": {
          "includeFiles": "public/**",
          "maxDuration": 120
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "recognition",
          "format": "url",
          "env": "FLOORPLAN_RECOGNITION_URL"
        }
      ]
    },
    "recognition": {
      "root": "services/floorplan",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "website" } }
  ]
}
